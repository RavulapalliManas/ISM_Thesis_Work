\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Arena layouts by symmetry order. S4 has $C_4$ rotational symmetry; S2 has $C_2$ symmetry; S1 is asymmetric.\relax }}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:arena}{{2}{5}{Arena layouts by symmetry order. S4 has $C_4$ rotational symmetry; S2 has $C_2$ symmetry; S1 is asymmetric.\relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Why sRSA is invariant to permutations. Left: rotated map preserves distances. Right: locally folded map also preserves rank order. Both yield identical pairwise distances.\relax }}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:srsa}{{3}{6}{Why sRSA is invariant to permutations. Left: rotated map preserves distances. Right: locally folded map also preserves rank order. Both yield identical pairwise distances.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Three mechanistically distinct outcomes. Left: global degeneracy with full collapse. Center: partial folding (observed here). Right: null case (no cost). Quadrant colors show local spatial code.\relax }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:outcomes}{{4}{7}{Three mechanistically distinct outcomes. Left: global degeneracy with full collapse. Center: partial folding (observed here). Right: null case (no cost). Quadrant colors show local spatial code.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Seed-to-seed RSA over training. All conditions converge to sRSA $> 0.5$; S1 (asymmetric) reaches highest final value.\relax }}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:learn}{{5}{7}{Seed-to-seed RSA over training. All conditions converge to sRSA $> 0.5$; S1 (asymmetric) reaches highest final value.\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Final metric comparison by condition. PAA (global alignment), RA (unit aliasing), SCI (population compression), and C2 Contrast (subgroup encoding). Points show individual seeds; bars show mean $\pm $ spread.\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:dash}{{6}{8}{Final metric comparison by condition. PAA (global alignment), RA (unit aliasing), SCI (population compression), and C2 Contrast (subgroup encoding). Points show individual seeds; bars show mean $\pm $ spread.\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cross-seed alignment analysis. Top: off-diagonal RSA values exceed 0.97 in all conditions. PAA gain does not improve upon identity alignment. Bottom: top canonical correlations remain near ceiling, indicating subspace alignment.\relax }}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:align}{{7}{9}{Cross-seed alignment analysis. Top: off-diagonal RSA values exceed 0.97 in all conditions. PAA gain does not improve upon identity alignment. Bottom: top canonical correlations remain near ceiling, indicating subspace alignment.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Unit-level tuning properties by symmetry. Top: rotational autocorrelation maps with quadrant boundaries marked. Red indicates high autocorrelation (cannot distinguish quadrants). Bottom: spatial information distributions with means indicated.\relax }}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:tune}{{8}{10}{Unit-level tuning properties by symmetry. Top: rotational autocorrelation maps with quadrant boundaries marked. Red indicates high autocorrelation (cannot distinguish quadrants). Bottom: spatial information distributions with means indicated.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Population-level compression metrics. Top: fraction of tuned cells decreases with symmetry order. Middle: SCI values show 11\% symmetric-pair compression in S4. Bottom: decoding error increases with symmetry.\relax }}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:decode}{{9}{12}{Population-level compression metrics. Top: fraction of tuned cells decreases with symmetry order. Middle: SCI values show 11\% symmetric-pair compression in S4. Bottom: decoding error increases with symmetry.\relax }{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Distance-Topology Gap ($\Delta _{\text  {TG}}$) over training. Negative values indicate city-block structure dominance. Gap widens (becomes more negative) in S4.\relax }}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:dtg}{{10}{14}{Distance-Topology Gap ($\Delta _{\text {TG}}$) over training. Negative values indicate city-block structure dominance. Gap widens (becomes more negative) in S4.\relax }{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Manifold geometry by symmetry condition. Top: online intrinsic dimensionality estimates during training converge to 5.7--6.0. Bottom: t-SNE visualizations (PCA to 64D first). S1 shows continuous gradient; S4 shows fragmented multi-arm structure; S2 shows symmetric two-lobe structure.\relax }}{16}{figure.caption.11}\protected@file@percent }
\newlabel{fig:manifold}{{11}{16}{Manifold geometry by symmetry condition. Top: online intrinsic dimensionality estimates during training converge to 5.7--6.0. Bottom: t-SNE visualizations (PCA to 64D first). S1 shows continuous gradient; S4 shows fragmented multi-arm structure; S2 shows symmetric two-lobe structure.\relax }{figure.caption.11}{}}
