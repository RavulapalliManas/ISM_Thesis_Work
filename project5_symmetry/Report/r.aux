\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Arena layouts by symmetry. S4 has $C_4$ symmetry (four-fold rotational equiv.); S2 has $C_2$ symmetry (two-fold); S1 is asymmetric. Landmark shapes and positions are matched for observational discriminability across conditions.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arena}{{1}{2}{Arena layouts by symmetry. S4 has $C_4$ symmetry (four-fold rotational equiv.); S2 has $C_2$ symmetry (two-fold); S1 is asymmetric. Landmark shapes and positions are matched for observational discriminability across conditions}{figure.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Observational discriminability (ODI) decomposition by condition. Within-condition and cross-condition pairwise distances confirm that all three conditions are matched on $\mathrm  {ODI}=0.336$ despite different symmetry orders.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:odi}{{2}{3}{Observational discriminability (ODI) decomposition by condition. Within-condition and cross-condition pairwise distances confirm that all three conditions are matched on $\mathrm {ODI}=0.336$ despite different symmetry orders}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Why sRSA is invariant to permutations. Row permutations of the neural population matrix leave all pairwise distances unchanged, so rotated maps yield identical sRSA values even when they represent opposite global orientations.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:srsa}{{3}{3}{Why sRSA is invariant to permutations. Row permutations of the neural population matrix leave all pairwise distances unchanged, so rotated maps yield identical sRSA values even when they represent opposite global orientations}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mechanistically distinct outcomes. Left: collapse. Center: partial folding (observed). Right: null case.}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:outcomes}{{4}{4}{Mechanistically distinct outcomes. Left: collapse. Center: partial folding (observed). Right: null case}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Final metric comparison. PAA (global), RA (aliasing), SCI (compression), and C2 Contrast (grouping).}}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dash}{{5}{4}{Final metric comparison. PAA (global), RA (aliasing), SCI (compression), and C2 Contrast (grouping)}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cross-seed RDM (Representational Dissimilarity Matrix) alignment. S4, S2, and S1 all show strong RSA alignment across seeds.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:rdm}{{6}{4}{Cross-seed RDM (Representational Dissimilarity Matrix) alignment. S4, S2, and S1 all show strong RSA alignment across seeds}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces DTG (Distance-Topology Gap, $\Delta _{\text  {TG}}$). Gap widens in S4, indicating path-dependence.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:dtg}{{7}{4}{DTG (Distance-Topology Gap, $\Delta _{\text {TG}}$). Gap widens in S4, indicating path-dependence}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Learning trajectories of key metrics across training.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:ltraj}{{8}{5}{Learning trajectories of key metrics across training}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Example place cell rate maps for the six highest-EVS units per condition (seed\_00). \textbf  {S1:} compact, idiosyncratic single fields typical of healthy place cells. \textbf  {S2:} bilateral or 4-fold symmetric fields: the same firing pattern duplicated at rotationally equivalent positions. \textbf  {S4:} cross-shaped and stripe-like patterns emerge; some units are nearly silent; fields are substantially broader than S1. These patterns are the signature of partial folding. The network encodes within-quadrant position but cannot disambiguate which quadrant.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:tune}{{9}{6}{Example place cell rate maps for the six highest-EVS units per condition (seed\_00). \textbf {S1:} compact, idiosyncratic single fields typical of healthy place cells. \textbf {S2:} bilateral or 4-fold symmetric fields: the same firing pattern duplicated at rotationally equivalent positions. \textbf {S4:} cross-shaped and stripe-like patterns emerge; some units are nearly silent; fields are substantially broader than S1. These patterns are the signature of partial folding. The network encodes within-quadrant position but cannot disambiguate which quadrant}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Distribution of rotational autocorrelation (RA) values across the neural population by condition. The distribution shifts rightward and narrows with increasing symmetry order. Under C\textsubscript  {4} symmetry, aliasing is distributed more homogeneously across the population - consistent with a redistributed aliasing account in which the network avoids concentrating high-RA responses in a decodable subpopulation. this explains the dissociation between unit-level aliasing (RA) and population-level compression (SCI), the population code remains separable even as individual units alias.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:ra_dist}{{10}{6}{Distribution of rotational autocorrelation (RA) values across the neural population by condition. The distribution shifts rightward and narrows with increasing symmetry order. Under C\textsubscript {4} symmetry, aliasing is distributed more homogeneously across the population - consistent with a redistributed aliasing account in which the network avoids concentrating high-RA responses in a decodable subpopulation. this explains the dissociation between unit-level aliasing (RA) and population-level compression (SCI), the population code remains separable even as individual units alias}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Field width distributions by condition. The heavy right tail in S4 reflects a subpopulation developing fields spanning the full arena width, while median field width is similar across conditions. }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:fieldsize}{{11}{7}{Field width distributions by condition. The heavy right tail in S4 reflects a subpopulation developing fields spanning the full arena width, while median field width is similar across conditions}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Decoding confusion under symmetry. In S4, errors concentrate near the cardinal and diagonal symmetry axes (overlaid dashed lines), forming a cross-shaped pattern that directly reflects the four-fold equivalence structure of the arena. Positions on these axes are hardest to disambiguate because they are geometrically closest to multiple C\textsubscript  {4}-equivalent positions simultaneously.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:decode}{{12}{7}{Decoding confusion under symmetry. In S4, errors concentrate near the cardinal and diagonal symmetry axes (overlaid dashed lines), forming a cross-shaped pattern that directly reflects the four-fold equivalence structure of the arena. Positions on these axes are hardest to disambiguate because they are geometrically closest to multiple C\textsubscript {4}-equivalent positions simultaneously}{figure.caption.10}{}}
