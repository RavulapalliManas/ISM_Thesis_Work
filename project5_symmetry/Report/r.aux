\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Spectral gap of the recurrent weight matrix $\mathbf  {W}_h$. The dominant eigenvalue grows relative to the rest of the spectrum as symmetry increases, but this predicts worse spatial maps, not better.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:spectral}{{15}{9}{Spectral gap of the recurrent weight matrix $\mathbf {W}_h$. The dominant eigenvalue grows relative to the rest of the spectrum as symmetry increases, but this predicts worse spatial maps, not better}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces HD ablation results. Removing head input causes map collapse (sRSA drops below the 0.40 formation gate). Degrading directional specificity produces the same failure.}}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:hdablation}{{16}{9}{HD ablation results. Removing head input causes map collapse (sRSA drops below the 0.40 formation gate). Degrading directional specificity produces the same failure}{figure.caption.14}{}}
