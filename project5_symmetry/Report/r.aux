\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Predicted successor representation (SR) geometry vs.\ observed neural RDM for S4. Left: predicted SR distance matrix $\mathbf  {D}_{\text  {SR}} = 1 - \mathbf  {M}/\max (\mathbf  {M})$ computed analytically as $\mathbf  {M} = (\mathbf  {I} - \gamma \mathbf  {T})^{-1}$ under random walk ($\gamma = 0.95$). Right: observed neural RDM. Spearman $r = 0.66$ between upper triangles, confirming that the pRNN's representational geometry approximates the SR prediction - including the block structure arising from C\textsubscript  {4}-equivalent positions sharing expected future state distributions.}}{11}{figure.caption.15}\protected@file@percent }
\newlabel{fig:sr_rdm}{{17}{11}{Predicted successor representation (SR) geometry vs.\ observed neural RDM for S4. Left: predicted SR distance matrix $\mathbf {D}_{\text {SR}} = 1 - \mathbf {M}/\max (\mathbf {M})$ computed analytically as $\mathbf {M} = (\mathbf {I} - \gamma \mathbf {T})^{-1}$ under random walk ($\gamma = 0.95$). Right: observed neural RDM. Spearman $r = 0.66$ between upper triangles, confirming that the pRNN's representational geometry approximates the SR prediction - including the block structure arising from C\textsubscript {4}-equivalent positions sharing expected future state distributions}{figure.caption.15}{}}
