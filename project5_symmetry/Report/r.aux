\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Why sRSA is invariant to permutations. Left: rotated map preserves distances. Right: locally folded map also preserves rank order. Both yield identical pairwise distances.\relax }}{5}{figure.caption.2}\protected@file@percent }
\newlabel{fig:srsa}{{2}{5}{Why sRSA is invariant to permutations. Left: rotated map preserves distances. Right: locally folded map also preserves rank order. Both yield identical pairwise distances.\relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Three mechanistically distinct outcomes. Left: global degeneracy with full collapse. Center: partial folding (observed here). Right: null case (no cost). Quadrant colors show local spatial code.\relax }}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:outcomes}{{3}{6}{Three mechanistically distinct outcomes. Left: global degeneracy with full collapse. Center: partial folding (observed here). Right: null case (no cost). Quadrant colors show local spatial code.\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Final metric comparison by condition. PAA (global alignment), RA (unit aliasing), SCI (population compression), and C2 Contrast (subgroup encoding). Points show individual seeds; bars show mean $\pm $ spread.\relax }}{7}{figure.caption.4}\protected@file@percent }
\newlabel{fig:dash}{{4}{7}{Final metric comparison by condition. PAA (global alignment), RA (unit aliasing), SCI (population compression), and C2 Contrast (subgroup encoding). Points show individual seeds; bars show mean $\pm $ spread.\relax }{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cross-seed alignment analysis. Top: off-diagonal RSA values exceed 0.97 in all conditions. PAA gain does not improve upon identity alignment. Bottom: top canonical correlations remain near ceiling, indicating subspace alignment.\relax }}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:align}{{5}{8}{Cross-seed alignment analysis. Top: off-diagonal RSA values exceed 0.97 in all conditions. PAA gain does not improve upon identity alignment. Bottom: top canonical correlations remain near ceiling, indicating subspace alignment.\relax }{figure.caption.5}{}}
