\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Inter-quadrant neural distances and RDM structure. S1 RDM shows no block structure - inter-quadrant distances are uniformly distributed. S2 RDM shows 2$\times $2 block structure - C\textsubscript  {2}-related quadrant pairs compress relative to C\textsubscript  {4}-related pairs. S4 RDM shows 4$\times $4 uniform block compression - all inter-quadrant pairs are equally similar, erasing subgroup structure.}}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:quadrant}{{13}{8}{Inter-quadrant neural distances and RDM structure. S1 RDM shows no block structure - inter-quadrant distances are uniformly distributed. S2 RDM shows 2$\times $2 block structure - C\textsubscript {2}-related quadrant pairs compress relative to C\textsubscript {4}-related pairs. S4 RDM shows 4$\times $4 uniform block compression - all inter-quadrant pairs are equally similar, erasing subgroup structure}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Manifold geometry. Left: intrinsic dimensionality over training, increasing with symmetry order. Right: Isomap projections showing local fragmentation in S4 and S2 while global structure is preserved.}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:manifold}{{14}{8}{Manifold geometry. Left: intrinsic dimensionality over training, increasing with symmetry order. Right: Isomap projections showing local fragmentation in S4 and S2 while global structure is preserved}{figure.caption.12}{}}
