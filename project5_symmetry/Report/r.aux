\newlabel{fig:tune}{{6}{9}{Unit-level tuning properties by symmetry. Top: rotational autocorrelation maps with quadrant boundaries marked. Red indicates high autocorrelation (cannot distinguish quadrants). Bottom: spatial information distributions with means indicated.\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Distance-Topology Gap ($\Delta _{\text  {TG}}$) over training. Negative values indicate city-block structure dominance. Gap widens (becomes more negative) in S4.\relax }}{11}{figure.caption.7}\protected@file@percent }
\newlabel{fig:dtg}{{7}{11}{Distance-Topology Gap ($\Delta _{\text {TG}}$) over training. Negative values indicate city-block structure dominance. Gap widens (becomes more negative) in S4.\relax }{figure.caption.7}{}}
